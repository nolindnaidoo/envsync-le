	{
		"name": "files are required",
		"arguments": {},
		"expectedError": "files is required and must be a non-empty array of { path, content }"
	},
	{
		"name": "an empty list is refused",
		"arguments": {
			"files": []
		},
		"expectedError": "files is required and must be a non-empty array of { path, content }"
	},
	{
		"name": "template mode with no template path is refused",
		"files": [
			".env"
		],
		"arguments": {
			"mode": "template"
		},
		"expectedError": "templatePath is required when mode is \"template\""
	},
	{
		"name": "a mode the engine does not have is refused",
		"files": [
			".env"
		],
		"arguments": {
			"mode": "manual"
		},
		"expectedError": "mode must be \"auto\" or \"template\""
	},
	{
		"name": "an entry without content is named",
		"arguments": {
			"files": [
				{
					"path": ".env"
				}
			]
		},
		"expectedError": "files[0] must have string `path` and `content`"
	},
	{
		"name": "a caseSensitive that is not true or false is refused",
		"files": [
			".env"
		],
		"arguments": {
			"caseSensitive": "no"
		},
		"expectedError": "caseSensitive must be true or false"
	},
