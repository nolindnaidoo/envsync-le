	"comparison": [
		{
			"name": "auto: three files",
			"files": [
				".env",
				".env.example",
				".env.production"
			],
			"options": {},
			"expected": {
				"status": "missing-keys",
				"files": [
					{
						"path": ".env",
						"type": "base",
						"keys": 4
					},
					{
						"path": ".env.example",
						"type": "example",
						"keys": 4
					},
					{
						"path": ".env.production",
						"type": "production",
						"keys": 4
					}
				],
				"missingKeys": [
					{
						"filepath": ".env",
						"keys": [
							"SENTRY_DSN"
						],
						"reference": ".env.example"
					},
					{
						"filepath": ".env.example",
						"keys": [
							"LOCAL_ONLY"
						],
						"reference": ".env"
					},
					{
						"filepath": ".env.production",
						"keys": [
							"LOCAL_ONLY"
						],
						"reference": ".env"
					}
				],
				"extraKeys": [],
				"errors": []
			}
		},
