{
	"name": "envsync-le",
	"version": "2.2.6",
	"author": {
		"name": "nolindnaidoo",
		"url": "https://nolindnaidoo.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nolindnaidoo/envsync-le.git"
	},
	"l10n": "./l10n",
	"main": "./dist/extension.js",
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.5.1",
		"@types/vscode": "1.101.0",
		"@vitest/coverage-v8": "^4.1.11",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.2",
		"mocha": "^11.8.0",
		"ovsx": "^1.2.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"activationEvents": [
		"workspaceContains:**/.env*"
	],
	"bugs": {
		"url": "https://github.com/nolindnaidoo/envsync-le/issues"
	},
	"capabilities": {
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "%manifest.capability.virtual-workspaces.desc%"
		},
		"untrustedWorkspaces": {
			"supported": false,
			"description": "%manifest.capability.untrusted-workspaces.desc%"
		}
	},
	"categories": [
		"Linters",
		"Testing",
		"Programming Languages"
	],
	"contributes": {
		"commands": [
			{
				"command": "envsync-le.openSettings",
				"title": "%manifest.command.settings.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.showIssues",
				"title": "%manifest.command.show-issues.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.compareSelected",
				"title": "%manifest.command.compare-selected.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.setTemplate",
				"title": "%manifest.command.set-template.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.clearTemplate",
				"title": "%manifest.command.clear-template.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.ignoreFile",
				"title": "%manifest.command.ignore-file.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.stopIgnoring",
				"title": "%manifest.command.stop-ignoring.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.clearAllIgnored",
				"title": "%manifest.command.clear-all-ignored.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "envsync-le.help",
				"title": "%manifest.command.help.title%",
				"category": "%manifest.command.category%"
			}
		],
		"keybindings": [
			{
				"command": "envsync-le.showIssues",
				"key": "ctrl+alt+s",
				"mac": "cmd+alt+s",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "envsync-le.compareSelected",
					"when": "resourceFilename =~ /^\\.env\\.|\\.env$/",
					"group": "dotsync@1"
				},
				{
					"command": "envsync-le.ignoreFile",
					"when": "resourceFilename =~ /^\\.env\\.|\\.env$/",
					"group": "dotsync@2"
				}
			]
		},
		"configuration": {
			"title": "%manifest.settings.title%",
			"properties": {
				"envsync-le.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.enabled.desc%"
				},
				"envsync-le.watchPatterns": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						".env*"
					],
					"description": "%manifest.settings.watch-patterns.desc%"
				},
				"envsync-le.excludePatterns": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%manifest.settings.exclude-patterns.desc%"
				},
				"envsync-le.notificationLevel": {
					"type": "string",
					"default": "important",
					"enum": [
						"all",
						"important",
						"silent"
					],
					"description": "%manifest.settings.notifications.level.desc%",
					"enumDescriptions": [
						"%manifest.settings.notifications.level.option.all%",
						"%manifest.settings.notifications.level.option.important%",
						"%manifest.settings.notifications.level.option.silent%"
					]
				},
				"envsync-le.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.statusbar.enabled.desc%"
				},
				"envsync-le.debounceMs": {
					"type": "number",
					"default": 1000,
					"minimum": 100,
					"description": "%manifest.settings.debounce.desc%"
				},
				"envsync-le.caseSensitive": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.case-sensitive.desc%"
				},
				"envsync-le.telemetryEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.telemetry.desc%"
				},
				"envsync-le.comparisonMode": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"manual",
						"template"
					],
					"description": "%manifest.settings.comparison-mode.desc%",
					"enumDescriptions": [
						"%manifest.settings.comparison-mode.option.auto%",
						"%manifest.settings.comparison-mode.option.manual%",
						"%manifest.settings.comparison-mode.option.template%"
					]
				},
				"envsync-le.compareOnlyFiles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%manifest.settings.compare-only-files.desc%"
				},
				"envsync-le.templateFile": {
					"type": "string",
					"description": "%manifest.settings.template-file.desc%"
				},
				"envsync-le.temporaryIgnore": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%manifest.settings.temporary-ignore.desc%"
				}
			}
		},
		"mcpServerDefinitionProviders": [
			{
				"id": "envsync-le",
				"label": "%manifest.mcp.label%"
			}
		]
	},
	"description": "Compare the dotenv files in a tree, and say which keys are missing from which",
	"displayName": "EnvSync-LE",
	"engines": {
		"vscode": "^1.101.0",
		"node": ">=20.0.0"
	},
	"homepage": "https://letools.dev/tools/envsync-le",
	"icon": "src/assets/images/icon.png",
	"keywords": [
		"env",
		"dotenv",
		"environment",
		"environment-variables",
		"env-vars",
		"env-example",
		"sync",
		"compare",
		"comparison",
		"diff",
		"missing-keys",
		"drift",
		"parity",
		"template",
		"config",
		"configuration",
		"settings",
		"workspace",
		"monorepo",
		"consistency",
		"validation",
		"audit",
		"docker",
		"deployment",
		"onboarding",
		"ci",
		"team",
		"developer-tools",
		"secrets",
		"twelve-factor"
	],
	"license": "MIT",
	"publisher": "nolindnaidoo",
	"scripts": {
		"clean": "node -e \"const fs=require('fs');['dist','coverage','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
		"clean:i18n": "node -e \"const fs=require('fs');fs.readdirSync('.').filter(f=>f.startsWith('package.nls.')&&f.endsWith('.json')&&f!=='package.nls.json').forEach(f=>fs.unlinkSync(f))\"",
		"copy:i18n": "node -e \"const fs=require('fs');fs.readdirSync('src/i18n').forEach(f=>fs.copyFileSync('src/i18n/'+f,f))\"",
		"build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap",
		"build:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --minify --sourcemap=external",
		"watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"check:bundle": "node scripts/check-bundle.js",
		"build:mcp": "node scripts/build-mcp.js",
		"build:mcp:prod": "node scripts/build-mcp.js --prod",
		"check:mcp-bundle": "node scripts/check-mcp-bundle.js",
		"build:npm": "node scripts/build-npm.js",
		"check:npm-package": "node scripts/check-npm-package.js",
		"test": "vitest run --pool=threads",
		"test:watch": "vitest --pool=threads",
		"test:coverage": "vitest run --coverage --pool=threads --reporter=default --reporter=json --outputFile.json=coverage/test-results.json",
		"benchmark": "bun scripts/benchmark.ts",
		"perf:readme": "node scripts/perf-readme.js",
		"coverage:readme": "node scripts/coverage-readme.js",
		"coverage:readme:check": "node scripts/coverage-readme.js --check",
		"readme": "bun run test:coverage && bun run coverage:readme",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"vscode:prepublish": "npm run typecheck && npm run build:prod && npm run build:mcp:prod && npm run check:bundle && npm run check:mcp-bundle && npm run copy:i18n",
		"package": "node -e \"require('fs').mkdirSync('release',{recursive:true})\" && vsce package --no-dependencies --out release/ && npm run clean:i18n",
		"test:integration": "npm run build && tsc -p tsconfig.it.json && vscode-test",
		"test:e2e-vsix": "node scripts/e2e-vsix.js",
		"hooks:install": "node scripts/install-hooks.js",
		"lint:commits": "node scripts/commit-lint.js --range origin/main..HEAD",
		"prepare": "node scripts/install-hooks.js"
	}
}
